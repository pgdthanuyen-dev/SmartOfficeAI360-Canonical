# B7 Planner draft handoff. Keep the real secret only in a local environment file.
SMARTOFFICE_PLANNER_HANDOFF_ENABLED=false
SMARTOFFICE_PLANNER_BASE_URL=https://planner.example.invalid
SMARTOFFICE_PLANNER_HANDOFF_SECRET=replace-with-local-secret
# Optional; rendered only after a successful receiver response with a draft id.
SMARTOFFICE_PLANNER_DRAFT_URL_TEMPLATE=https://planner.example.invalid/smartoffice/drafts/{draft_id}
SMARTOFFICE_PLANNER_HANDOFF_TIMEOUT_SECONDS=10
